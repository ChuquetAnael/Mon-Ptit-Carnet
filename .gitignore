# =========================================================================
# Mon P'tit Carnet — fichiers à ne jamais envoyer sur GitHub (dépôt public)
# =========================================================================

# Secrets et configuration propre à chaque poste
BDD/env.local.php
cle/
*.env
.env*

# Données des membres (photos, cartes de pêche) : seuls les .htaccess de protection sont suivis
uploads/*
!uploads/.htaccess
stockage_prive/*
!stockage_prive/.htaccess

# Sauvegardes de base de données (elles contiennent e-mails et mots de passe chiffrés)
*.sql
*.sql.gz
*.sql.zip
!BDD/migrations/*.sql

# Livraisons et correctifs reçus (bundles Git, patchs, archives, guides PDF)
*.bundle
*.patch
*.diff
*.orig
*.rej
*.zip
*.tgz
*.tar.gz
Guide_*.pdf
apercu_*.png

# Outils d'IA et assistants de code (réglages locaux, caches)
.claude/
CLAUDE.local.md
.cursor/
.aider*
.continue/
.codeium/

# Éditeurs et IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.code-workspace
*.sublime-*
.history/
*.swp
*.swo
*~

# Systèmes d'exploitation
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/

# Dépendances, tests et fichiers temporaires
node_modules/
vendor/
!script/vendor/
composer.phar
test-results/
playwright-report/
coverage/
__pycache__/
*.pyc
*.log
*.tmp
*.bak
*.cache
